# ===================================================================
# HOTEL AVENTURA — VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas el archivo .env a GitHub.
# ===================================================================

# 1. Base de Datos Supabase (PostgreSQL)
DB_URL=jdbc:postgresql://db.vkwyflxorhikeayusxbf.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=[TU_PASSWORD_DE_SUPABASE]

# 2. Supabase Storage (Bucket para Fotos del Hotel)
SUPABASE_URL=https://vkwyflxorhikeayusxbf.supabase.co
SUPABASE_KEY=[TU_SERVICE_ROLE_KEY]
SUPABASE_STORAGE_BUCKET=imagenes

# 3. Criptografia y Seguridad JWT (Clave de 256 bits minimo)
JWT_SECRET=clave_secreta_super_segura_de_minimo_256_bits_hotel_aventura_2026
JWT_EXPIRATION=86400000
