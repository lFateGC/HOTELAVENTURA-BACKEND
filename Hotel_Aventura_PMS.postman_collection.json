    {
      "name": "00. Supabase Storage (Imágenes)",
      "item": [
        {
          "name": "Subir Imagen a Supabase Storage",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "Selecciona un archivo de imagen (JPG, PNG, WebP)"
                },
                {
                  "key": "carpeta",
                  "value": "habitaciones",
                  "type": "text",
                  "description": "Opciones: habitaciones, productos, incidencias, general"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/storage/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "storage", "upload"]
            },
            "description": "Sube un archivo multimedia al bucket de Supabase y retorna su URL pública permanente."
          }
        },
        {
          "name": "Eliminar Imagen de Supabase Storage",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/storage/delete?url=https://vkwyflxorhikeayusxbf.supabase.co/storage/v1/object/public/imagenes/habitaciones/ejemplo.png",
              "host": ["{{baseUrl}}"],
              "path": ["api", "storage", "delete"],
              "query": [
                {
                  "key": "url",
                  "value": "https://vkwyflxorhikeayusxbf.supabase.co/storage/v1/object/public/imagenes/habitaciones/ejemplo.png"
                }
              ]
            }
          }
        }
      ]
